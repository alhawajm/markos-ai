generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Locale {
  EN
  AR
}

enum PlanStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
}

enum OnboardingStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETE
}

enum VatMode {
  EXCLUSIVE
  INCLUSIVE
}

enum Role {
  OWNER
  EDITOR
  VIEWER
  WORKSPACE_ADMIN
  SUPER_ADMIN
  PRODUCT_ADMIN
  SUPPORT_ADMIN
  FINANCE_ADMIN
  READONLY_ADMIN
}

enum VaultSection {
  COMPANY
  STORY
  PRODUCTS
  AUDIENCE
  COMPETITORS
  BRAND
  TONE
  OBJECTIVES
}

enum ContentType {
  POST
  CAROUSEL
  STORY
  REEL
}

enum ContentStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  SCHEDULED
  PUBLISHED
  FAILED
}

enum MediaType {
  IMAGE
  VIDEO
  BRAND_ASSET
  AI_GENERATED
}

enum MetricType {
  ACCOUNT
  POST
  STORY
  REEL
  AUDIENCE
}

enum PaymentPurpose {
  SUBSCRIPTION
}

enum PaymentStatus {
  INITIATED
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
}

enum SubStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  PAID
  FAILED
  VOID
}

enum UsageMetric {
  AI_GENERATION
  AI_IMAGE
  AI_TOKENS_IN
  AI_TOKENS_OUT
  POST_PUBLISH
  CAMPAIGN
  STORAGE_BYTES
}

enum CampaignStatus {
  REVIEW
  APPROVED
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum InstagramConnectionStatus {
  PENDING
  CONNECTED
  EXPIRED
  REVOKED
  ERROR
}

enum OfferingKind {
  PRODUCT
  SERVICE
  UNSPECIFIED
}

enum OfferingStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum OfferingPriceType {
  UNSPECIFIED
  FIXED
  FROM
  RANGE
  QUOTE
}

enum OfferingSourceType {
  OWNER
  DOCUMENT
  INSTAGRAM
}

enum OfferingProjectionStatus {
  PENDING
  READY
  FAILED
}

enum OfferingDocumentAnalysisStatus {
  PROCESSING
  READY
  FAILED
  APPROVED
  DISCARDED
  EXPIRED
}

model User {
  id           String     @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  email        String     @unique
  passwordHash String?
  fullName     String
  locale       Locale     @default(AR)
  planId       String?    @db.Uuid
  planStatus   PlanStatus @default(TRIAL)
  trialEndsAt  DateTime?
  isVerified   Boolean    @default(false)
  mfaSecret    String?
  mfaEnabled   Boolean    @default(false)
  googleId     String?    @unique
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?

  @@map("users")
}

model Workspace {
  id                       String           @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  ownerUserId              String           @db.Uuid
  name                     String
  slug                     String           @unique
  instagramAccountId       String?
  instagramAccessToken     String?
  instagramTokenExpiresAt  DateTime?
  onboardingStatus         OnboardingStatus @default(NOT_STARTED)
  onboardingScore          Int              @default(0)
  onboardingSkippedModules String[]         @default([])
  vatPricingMode           VatMode          @default(EXCLUSIVE)
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt
  deletedAt                DateTime?

  @@index([ownerUserId])
  @@map("workspaces")
}

model WorkspaceMember {
  id          String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  workspaceId String    @db.Uuid
  userId      String    @db.Uuid
  role        Role
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@unique([workspaceId, userId, role])
  @@index([userId])
  @@map("workspace_members")
}

model InstagramConnectionCredential {
  id                      String                    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  workspaceId             String                    @unique @db.Uuid
  provider                String                    @default("INSTAGRAM")
  providerAccountId       String
  username                String
  accountType             String?
  profilePictureUrl       String?
  encryptedAccessToken    String
  tokenIssuedAt           DateTime
  tokenExpiresAt          DateTime
  status                  InstagramConnectionStatus @default(PENDING)
  requestedScopes         String[]
  providerConfirmedScopes String[]
  lastSyncedAt            DateTime?
  lastErrorCode           String?
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  deletedAt               DateTime?

  @@unique([provider, providerAccountId])
  @@index([workspaceId, status])
  @@map("instagram_connection_credentials")
}

model InstagramRecentMedia {
  id                String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  workspaceId       String    @db.Uuid
  connectionId      String    @db.Uuid
  providerMediaId   String
  mediaType         String
  caption           String?
  mediaUrl          String?
  thumbnailUrl      String?
  permalink         String?
  providerTimestamp DateTime?
  syncedAt          DateTime  @default(now())

  @@unique([connectionId, providerMediaId])
  @@index([workspaceId, connectionId])
  @@map("instagram_recent_media")
}

model OAuthStateNonce {
  id          String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  nonceHash   String    @unique
  workspaceId String    @db.Uuid
  userId      String    @db.Uuid
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([workspaceId, userId])
  @@map("oauth_state_nonces")
}

model KnowledgeVault {
  id          String                       @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  workspaceId String                       @db.Uuid
  section     VaultSection
  key         String
  value       Json
  embedding   Unsupported("vector(1536)")?
  version     Int                          @default(1)
  createdAt   DateTime                     @default(now())
  updatedAt   DateTime                     @updatedAt
  deletedAt   DateTime?

  @@index([workspaceId, section])
  @@map("knowledge_vault")
}

model KnowledgeVaultHistory {
  id               String       @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  workspaceId      String       @db.Uuid
  knowledgeVaultId String       @db.Uuid
  section          VaultSection
  key              String
  value            Json
  version          Int
  createdAt        DateTime     @default(now())

  @@unique([knowledgeVaultId, version])
  @@index([workspaceId, section, key])
  @@map("knowledge_vault_history")
}

model OfferingCatalog {
  id               String                   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  workspaceId      String                   @unique @db.Uuid
  summary          String?
  differentiators  String[]                 @default([])
  priceRange       String?
  salesChannels    String[]                 @default([])
  version          Int                      @default(1)
  sourceType       OfferingSourceType       @default(OWNER)
  projectionStatus OfferingProjectionStatus @default(PENDING)
  projectedVersion Int                      @default(0)
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  deletedAt        DateTime?

  @@index([workspaceId])
  @@map("offering_catalogs")
}

model OfferingCatalogRevision {
  id          String             @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  workspaceId String             @db.Uuid
  catalogId   String             @db.Uuid
  version     Int
  snapshot    Json
  sourceType  OfferingSourceType
  sourceRef   String?
  createdAt   DateTime           @default(now())

  @@unique([catalogId, version])
  @@index([workspaceId, catalogId])
  @@map("offering_catalog_revisions")
}

model Offering {
  id             String             @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  workspaceId    String             @db.Uuid
  catalogId      String             @db.Uuid
  kind           OfferingKind       @default(UNSPECIFIED)
  name           String
  normalizedName String
  nameEn         String?
  nameAr         String?
  category       String?
  description    String?
  priceType      OfferingPriceType  @default(UNSPECIFIED)
  priceMinor     Int?
  minPriceMinor  Int?
  maxPriceMinor  Int?
  currency       String             @default("BHD") @db.VarChar(3)
  status         OfferingStatus     @default(ACTIVE)
  version        Int                @default(1)
  sourceType     OfferingSourceType @default(OWNER)
  sourceRef      String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  deletedAt      DateTime?

  @@unique([workspaceId, normalizedName])
  @@index([workspaceId, catalogId, status])
  @@map("offerings")
}

model OfferingRevision {
  id          String             @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  workspaceId String             @db.Uuid
  offeringId  String             @db.Uuid
  version     Int
  snapshot    Json
  sourceType  OfferingSourceType
  sourceRef   String?
  createdAt   DateTime           @default(now())

  @@unique([offeringId, version])
  @@index([workspaceId, offeringId])
  @@map("offering_revisions")
}

model OfferingDocumentAnalysis {
  id            String                         @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  workspaceId   String                         @db.Uuid
  status        OfferingDocumentAnalysisStatus @default(PROCESSING)
  result        Json?
  failureCode   String?
  interactionId String?                        @db.Uuid
  expiresAt     DateTime
  approvedAt    DateTime?
  discardedAt   DateTime?
  createdAt     DateTime                       @default(now())
  updatedAt     DateTime                       @updatedAt

  @@index([workspaceId, status, createdAt])
  @@index([status, expiresAt])
  @@map("offering_document_analyses")
}

model OfferingDocumentFile {
  id             String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  workspaceId    String    @db.Uuid
  analysisId     String    @db.Uuid
  filename       String
  mimeType       String
  sizeBytes      Int
  checksumSha256 String    @db.VarChar(64)
  storageKey     String?
  removedAt      DateTime?
  createdAt      DateTime  @default(now())

  @@index([workspaceId, analysisId])
  @@map("offering_document_files")
}

model OnboardingDocumentAnalysis {
  id            String                         @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  workspaceId   String                         @db.Uuid
  status        OfferingDocumentAnalysisStatus @default(PROCESSING)
  result        Json?
  failureCode   String?
  interactionId String?                        @db.Uuid
  expiresAt     DateTime
  approvedAt    DateTime?
  discardedAt   DateTime?
  createdAt     DateTime                       @default(now())
  updatedAt     DateTime                       @updatedAt

  @@index([workspaceId, status, createdAt])
  @@index([status, expiresAt])
  @@map("onboarding_document_analyses")
}

model OnboardingDocumentFile {
  id             String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  workspaceId    String    @db.Uuid
  analysisId     String    @db.Uuid
  filename       String
  mimeType       String
  sizeBytes      Int
  checksumSha256 String    @db.VarChar(64)
  storageKey     String?
  removedAt      DateTime?
  createdAt      DateTime  @default(now())

  @@index([workspaceId, analysisId])
  @@map("onboarding_document_files")
}

model ContentCalendar {
  id          String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  workspaceId String    @db.Uuid
  month       DateTime
  plan        Json
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([workspaceId, month])
  @@map("content_calendars")
}

model Campaign {
  id              String         @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  workspaceId     String         @db.Uuid
  title           String
  objective       String?
  status          CampaignStatus @default(REVIEW)
  startsAt        DateTime
  endsAt          DateTime
  durationDays    Int
  publishesPerDay Int            @default(1)
  content         Json
  version         Int            @default(1)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  deletedAt       DateTime?
  contentItems    ContentItem[]

  @@index([workspaceId])
  @@index([workspaceId, status])
  @@index([workspaceId, startsAt])
  @@map("campaigns")
}

model ContentItem {
  id              String        @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  workspaceId     String        @db.Uuid
  contentType     ContentType
  status          ContentStatus @default(DRAFT)
  captionEn       String?
  captionAr       String?
  hashtags        String[]
  callToAction    String?
  mediaIds        String[]      @db.Uuid
  carousel        Json?
  reelScript      Json?
  contentPillar   String?
  campaignId      String?       @db.Uuid
  campaign        Campaign?     @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  aiPromptUsed    String?
  plannedAt       DateTime?
  scheduledAt     DateTime?
  publishedAt     DateTime?
  instagramPostId String?
  failureReason   String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?

  @@index([workspaceId, status])
  @@index([workspaceId, campaignId])
  @@index([workspaceId, plannedAt])
  @@index([workspaceId, scheduledAt])
  @@map("content_items")
}

model MediaAsset {
  id              String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  workspaceId     String    @db.Uuid
  type            MediaType
  filename        String
  s3Key           String
  cdnUrl          String
  mimeType        String
  sizeBytes       Int
  width           Int?
  height          Int?
  durationSeconds Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  @@index([workspaceId, type])
  @@map("media_assets")
}

model InstagramAnalytics {
  id            String     @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  workspaceId   String     @db.Uuid
  contentItemId String?    @db.Uuid
  metricType    MetricType
  dataDate      DateTime
  metrics       Json
  syncedAt      DateTime
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  deletedAt     DateTime?

  @@index([workspaceId, metricType, dataDate])
  @@map("instagram_analytics")
}

model AiInteraction {
  id            String                       @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  workspaceId   String                       @db.Uuid
  agent         String
  promptVersion String
  prompt        Json
  response      Json
  accepted      Boolean?
  edited        Boolean?
  regenerated   Boolean?
  tokensIn      Int
  tokensOut     Int
  costMinor     Int
  currency      String                       @default("BHD") @db.VarChar(3)
  model         String
  embedding     Unsupported("vector(1536)")?
  createdAt     DateTime                     @default(now())
  updatedAt     DateTime                     @updatedAt
  deletedAt     DateTime?

  @@index([workspaceId, agent])
  @@map("ai_interactions")
}

model Plan {
  id         String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  code       String    @unique
  name       String
  priceMinor Int
  currency   String    @default("BHD") @db.VarChar(3)
  limits     Json
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  @@map("plans")
}

model Subscription {
  id                 String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  userId             String    @db.Uuid
  workspaceId        String    @db.Uuid
  planId             String    @db.Uuid
  status             SubStatus @default(TRIALING)
  gateway            String
  gatewayCustomerId  String?
  gatewayTokenId     String?
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  @@index([workspaceId, status])
  @@map("subscriptions")
}

model Invoice {
  id             String        @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  userId         String        @db.Uuid
  workspaceId    String        @db.Uuid
  subscriptionId String?       @db.Uuid
  status         InvoiceStatus @default(DRAFT)
  netMinor       Int
  vatMinor       Int
  grossMinor     Int
  currency       String        @default("BHD") @db.VarChar(3)
  vatRateBps     Int           @default(1000)
  issuedAt       DateTime?
  paidAt         DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?

  @@index([workspaceId, status])
  @@map("invoices")
}

model Payment {
  id          String         @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  workspaceId String         @db.Uuid
  invoiceId   String?        @db.Uuid
  purpose     PaymentPurpose @default(SUBSCRIPTION)
  status      PaymentStatus  @default(INITIATED)
  gateway     String
  gatewayRef  String?
  amountMinor Int
  currency    String         @default("BHD") @db.VarChar(3)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  deletedAt   DateTime?

  @@index([workspaceId, status])
  @@map("payments")
}

model UsageCounter {
  id          String      @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  workspaceId String      @db.Uuid
  metric      UsageMetric
  periodStart DateTime
  periodEnd   DateTime
  used        BigInt      @default(0)
  limit       BigInt
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([workspaceId, metric, periodStart])
  @@map("usage_counters")
}

model PromptTemplate {
  id          String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  workspaceId String    @db.Uuid
  agent       String
  version     String
  body        String
  variantOf   String?   @db.Uuid
  trafficPct  Int       @default(100)
  active      Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@unique([workspaceId, agent, version])
  @@index([workspaceId, agent, active])
  @@map("prompt_templates")
}

model ModelSetting {
  id        String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  key       String    @unique
  value     String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("model_settings")
}

model Notification {
  id          String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  userId      String    @db.Uuid
  workspaceId String?   @db.Uuid
  channel     String
  templateKey String
  payload     Json
  readAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([userId, readAt])
  @@map("notifications")
}

model AuditLog {
  id          String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  actorId     String?  @db.Uuid
  workspaceId String?  @db.Uuid
  action      String
  targetType  String
  targetId    String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([workspaceId, action])
  @@index([actorId])
  @@map("audit_logs")
}
