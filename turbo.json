{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "dist/**", "build/**"]
    },
    "@markos/api-client#build": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@markos/i18n#build": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@markos/shared-types#build": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@markos/ui-tokens#build": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@markos/validation#build": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "ai#build": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "api#build": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "api#test": {
      "cache": false,
      "env": [
        "AI_BASE_URL",
        "AI_HTTP_TIMEOUT_MS",
        "API_BASE_URL",
        "CI",
        "DATABASE_URL",
        "GOOGLE_OAUTH_ISSUER",
        "GOOGLE_OAUTH_JWKS_URL",
        "INSTAGRAM_APP_ID",
        "INSTAGRAM_APP_SECRET",
        "INSTAGRAM_DATABASE_TEST_URL",
        "INSTAGRAM_GRAPH_VERSION",
        "INSTAGRAM_OAUTH_REDIRECT_URI",
        "INSTAGRAM_OAUTH_STATE_SECRET",
        "INSTAGRAM_TOKEN_ENCRYPTION_KEY",
        "INTERNAL_SERVICE_TOKEN",
        "JWT_ACCESS_SECRET",
        "JWT_REFRESH_SECRET",
        "LLM_LONGFORM_MODEL",
        "MEDIA_STORAGE_DIR",
        "NODE_ENV",
        "OPENSEARCH_URL",
        "REDIS_URL",
        "WEB_BASE_URL"
      ],
      "outputs": []
    },
    "ai#test": {
      "cache": false,
      "env": [
        "AI_CONTENT_TIMEOUT_SECONDS",
        "AI_PROFILE_TIMEOUT_SECONDS",
        "AI_CAMPAIGN_TIMEOUT_SECONDS",
        "AI_TEXT_PROVIDER",
        "INTERNAL_SERVICE_TOKEN",
        "LLM_LONGFORM_MODEL",
        "OPENAI_MAX_OUTPUT_TOKENS",
        "OPENAI_MAX_RETRIES",
        "OPENAI_REASONING_EFFORT",
        "OPENAI_STORE_RESPONSES",
        "OPENAI_TIMEOUT_SECONDS"
      ],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "passThroughEnv": [
        "AI_BASE_URL",
        "API_BASE_URL",
        "DATABASE_URL",
        "EMAIL_PROVIDER",
        "INSTAGRAM_ANALYTICS_SYNC_MODE",
        "INSTAGRAM_PUBLISH_MODE",
        "INTERNAL_SERVICE_TOKEN",
        "MEDIA_STORAGE_DRIVER",
        "NEXT_PUBLIC_API_BASE_URL",
        "OPENSEARCH_URL",
        "REDIS_URL",
        "WEB_BASE_URL",
        "AI_IMAGE_PROVIDER",
        "AI_TEXT_PROVIDER",
        "AI_VIDEO_PROVIDER",
        "OPENAI_API_KEY",
        "OPENAI_STORE_RESPONSES",
        "SENTRY_DSN",
        "NEXT_PUBLIC_SENTRY_DSN",
        "NEXT_TELEMETRY_DISABLED",
        "TURBO_TELEMETRY_DISABLED"
      ],
      "persistent": true
    },
    "infra#build": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "outputs": []
    }
  }
}
