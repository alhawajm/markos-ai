# --- Core ---
NODE_ENV=development
API_PORT=4000
# Railway injects PORT for the API. The current AI Docker image still listens on fixed port 8000.
PORT=4000
API_BASE_URL=http://localhost:4000
AI_PORT=8000
WEB_BASE_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
# Local Compose/dev URL. Railway must use the deployed AI service's reachable URL, not localhost.
AI_BASE_URL=http://localhost:8000
# Shared only between the API and AI services; both sides enforce this bearer token.
INTERNAL_SERVICE_TOKEN=change-me
DEFAULT_LOCALE=ar
DEFAULT_CURRENCY=BHD

# --- Database ---
DATABASE_URL=postgresql://markos:markos@localhost:5432/markos
DIRECT_DATABASE_URL=postgresql://markos:markos@localhost:5432/markos
APP_DB_ROLE=markos_app

# --- Redis / Queues ---
REDIS_URL=redis://localhost:6379

# --- Search ---
# Local Compose/dev URL. Railway must use the reachable OpenSearch service URL, not localhost.
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_USER=admin
OPENSEARCH_PASS=LocalSearch9#Wave

# --- Auth ---
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
MFA_STEP_UP_TTL=900
EMAIL_VERIFICATION_TTL=86400
MFA_ISSUER=MARKOS-AI
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_ISSUER=https://accounts.google.com
GOOGLE_OAUTH_JWKS_URL=https://www.googleapis.com/oauth2/v3/certs

# --- AI Models ---
# Text can use local deterministic output or OpenAI. Image generation is disabled
# unless a real OpenAI image provider is deliberately configured.
AI_TEXT_PROVIDER=local
AI_IMAGE_PROVIDER=disabled
AI_VIDEO_PROVIDER=disabled
AI_CAMPAIGN_TIMEOUT_SECONDS=50
AI_PROFILE_TIMEOUT_SECONDS=50
AI_DOCUMENT_TIMEOUT_SECONDS=50
AI_CONTENT_TIMEOUT_SECONDS=50
AI_IMAGE_TIMEOUT_SECONDS=120
AI_VIDEO_TIMEOUT_SECONDS=120
AI_HTTP_TIMEOUT_MS=130000
# Inventory placeholder only. For local use, put the key in services/ai/.env;
# in Railway, inject it only into the AI service.
OPENAI_API_KEY=
OPENAI_TIMEOUT_SECONDS=45
OPENAI_MAX_RETRIES=1
OPENAI_MAX_OUTPUT_TOKENS=4000
OPENAI_REASONING_EFFORT=low
# Keep provider inputs and outputs visible in the OpenAI dashboard during the quality-tuning phase.
# Stored Responses API application state is retained by OpenAI; use only approved, non-secret inputs and review before broader production use.
OPENAI_STORE_RESPONSES=true
ANTHROPIC_API_KEY=
REPLICATE_API_TOKEN=
LLM_PRIMARY_MODEL=
LLM_FLAGSHIP_MODEL=
LLM_LONGFORM_MODEL=
LLM_CHEAP_MODEL=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
IMAGE_MODEL_PRIMARY=
IMAGE_MODEL_FALLBACK=
VIDEO_MODEL_PRIMARY=
AI_PROMPT_CACHE=true
AI_BATCH_FOR_REPORTS=true

# --- Observability ---
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_SENTRY_RELEASE=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0

# --- Storage / CDN ---
MEDIA_STORAGE_DRIVER=local
MEDIA_STORAGE_DIR=var/media
# Optional stable media-proxy origin. When empty, generated media URLs use API_BASE_URL.
MEDIA_PUBLIC_BASE_URL=
# Required only when MEDIA_STORAGE_DRIVER=s3. In Railway, reference the private Bucket's five credential variables; set URL style explicitly.
AWS_ENDPOINT_URL=https://storage.railway.app
AWS_ACCESS_KEY_ID=fake-railway-bucket-access-key
AWS_SECRET_ACCESS_KEY=fake-railway-bucket-secret-key
AWS_S3_BUCKET_NAME=fake-markos-staging-bucket
AWS_DEFAULT_REGION=auto
# Railway Buckets use virtual-hosted S3 URLs. The dashboard does not create a service reference for this application-owned setting.
AWS_S3_URL_STYLE=virtual
# Provider-only presigned GET lifetime. The API caps this at 24 hours.
SIGNED_URL_TTL=3600

# --- Payments ---
CREDIMAX_MERCHANT_ID=
CREDIMAX_API_PASSWORD=
CREDIMAX_BASE_URL=https://credimax.gateway.mastercard.com
CREDIMAX_API_VERSION=
BENEFIT_MERCHANT_ID=
BENEFIT_SECRET=
BENEFIT_BASE_URL=
STRIPE_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=
VAT_RATE_BPS=1000
VAT_PRICING_MODE=exclusive

# --- Instagram Login (fake local examples only) ---
INSTAGRAM_APP_ID=000000000000000
INSTAGRAM_APP_SECRET=fake-instagram-app-secret
INSTAGRAM_OAUTH_REDIRECT_URI=http://localhost:4000/v1/workspace/instagram/oauth/callback
INSTAGRAM_GRAPH_VERSION=v25.0
INSTAGRAM_TOKEN_ENCRYPTION_KEY=ZmFrZS1sb2NhbC1rZXktMzItYnl0ZXMtbG9uZyEhISE=
INSTAGRAM_OAUTH_STATE_SECRET=fake-local-oauth-state-secret-at-least-32-bytes
# Inert compatibility inputs; the active Instagram Login client fixes these OAuth hosts in code.
INSTAGRAM_OAUTH_AUTHORIZE_URL=https://www.instagram.com/oauth/authorize
INSTAGRAM_OAUTH_TOKEN_URL=https://api.instagram.com/oauth/access_token
INSTAGRAM_LONG_LIVED_TOKEN_URL=https://graph.instagram.com/access_token
# Inert compatibility input; secure refresh uses the client-constrained provider endpoint.
INSTAGRAM_REFRESH_TOKEN_URL=https://graph.instagram.com/refresh_access_token
# Canonical allowlist only; reconnect after changing this value so the stored credential records the same request.
INSTAGRAM_OAUTH_SCOPES=instagram_business_basic,instagram_business_content_publish,instagram_business_manage_insights
INSTAGRAM_GRAPH_REQUEST_TIMEOUT_MS=15000
INSTAGRAM_GRAPH_MAX_RESPONSE_BYTES=262144
INSTAGRAM_TOKEN_REFRESH_WINDOW_DAYS=14
INSTAGRAM_PUBLISH_MODE=dry_run
INSTAGRAM_ANALYTICS_SYNC_MODE=dry_run
INSTAGRAM_CONTAINER_POLL_ATTEMPTS=6
INSTAGRAM_CONTAINER_POLL_DELAY_MS=60000
WORKER_PUBLISHING_INTERVAL_MS=60000
WORKER_ANALYTICS_EMAIL_INTERVAL_MS=86400000
WORKER_ANALYTICS_SYNC_INTERVAL_MS=21600000
WORKER_TOKEN_REFRESH_INTERVAL_MS=3600000
WORKER_USAGE_RESET_INTERVAL_MS=3600000
META_WEBHOOK_VERIFY_TOKEN=change-me-for-meta-dashboard

# --- Email ---
# Use `local` for development. Production verification delivery uses `sendgrid`.
EMAIL_PROVIDER=local
SENDGRID_API_KEY=
SES_REGION=me-south-1
FROM_EMAIL=no-reply@markos.bh

# --- Health timeouts ---
HEALTH_DEPENDENCY_TIMEOUT_MS=1000
HEALTH_DATABASE_TIMEOUT_MS=1000
HEALTH_REDIS_TIMEOUT_MS=1000
HEALTH_HTTP_TIMEOUT_MS=200
