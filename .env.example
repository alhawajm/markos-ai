# --- Core ---
NODE_ENV=development
API_PORT=4000
API_BASE_URL=http://localhost:4000
AI_PORT=8000
WEB_BASE_URL=http://localhost:3000
# Local Compose/dev URL. Railway must use the deployed AI service's reachable URL, not localhost.
AI_BASE_URL=http://localhost:8000
# Reserved for the API-to-AI boundary; current source loads this value but does not enforce or send it yet.
INTERNAL_SERVICE_TOKEN=change-me
DEFAULT_LOCALE=ar
DEFAULT_CURRENCY=BHD

# --- Database ---
DATABASE_URL=postgresql://markos:markos@localhost:5432/markos
DIRECT_DATABASE_URL=postgresql://markos:markos@localhost:5432/markos
APP_DB_ROLE=markos_app

# --- Redis / Queues ---
REDIS_URL=redis://localhost:6379

# --- Search ---
# Local Compose/dev URL. Railway must use the reachable OpenSearch service URL, not localhost.
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_USER=admin
OPENSEARCH_PASS=LocalSearch9#Wave

# --- Auth ---
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
MFA_ISSUER=MARKOS-AI
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_ISSUER=https://accounts.google.com
GOOGLE_OAUTH_JWKS_URL=https://www.googleapis.com/oauth2/v3/certs

# --- AI Models ---
# Future provider placeholders. The current FastAPI service does not consume these credentials.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
REPLICATE_API_TOKEN=
LLM_PRIMARY_MODEL=
LLM_FLAGSHIP_MODEL=
LLM_LONGFORM_MODEL=
LLM_CHEAP_MODEL=
EMBEDDING_MODEL=text-embedding-3-small
IMAGE_MODEL_PRIMARY=
IMAGE_MODEL_FALLBACK=
AI_PROMPT_CACHE=true
AI_BATCH_FOR_REPORTS=true

# --- Observability ---
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_SENTRY_RELEASE=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0

# --- Storage / CDN ---
# Build-spec target placeholders. Current media storage uses MEDIA_STORAGE_DIR and MEDIA_PUBLIC_BASE_URL only.
S3_BUCKET=markos-media-dev
S3_REGION=me-south-1
CDN_BASE_URL=https://cdn-dev.markos.bh
MEDIA_STORAGE_DIR=var/media
# Optional. When empty or omitted, generated media URLs use API_BASE_URL.
MEDIA_PUBLIC_BASE_URL=
SIGNED_URL_TTL=3600

# --- Payments ---
CREDIMAX_MERCHANT_ID=
CREDIMAX_API_PASSWORD=
CREDIMAX_BASE_URL=https://credimax.gateway.mastercard.com
CREDIMAX_API_VERSION=
BENEFIT_MERCHANT_ID=
BENEFIT_SECRET=
BENEFIT_BASE_URL=
STRIPE_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=
VAT_RATE_BPS=1000
VAT_PRICING_MODE=exclusive

# --- Instagram Login (fake local examples only) ---
INSTAGRAM_APP_ID=000000000000000
INSTAGRAM_APP_SECRET=fake-instagram-app-secret
INSTAGRAM_OAUTH_REDIRECT_URI=http://localhost:4000/v1/workspace/instagram/oauth/callback
INSTAGRAM_GRAPH_VERSION=v25.0
INSTAGRAM_GRAPH_BASE_URL=https://graph.instagram.com/v25.0
INSTAGRAM_TOKEN_ENCRYPTION_KEY=ZmFrZS1sb2NhbC1rZXktMzItYnl0ZXMtbG9uZyEhISE=
INSTAGRAM_OAUTH_STATE_SECRET=fake-local-oauth-state-secret-at-least-32-bytes
META_APP_ID=
META_APP_SECRET=
META_GRAPH_BASE_URL=https://graph.facebook.com
META_GRAPH_VERSION=v24.0
# Inert compatibility inputs; the active business-basic client fixes these hosts in code.
INSTAGRAM_OAUTH_AUTHORIZE_URL=https://www.instagram.com/oauth/authorize
INSTAGRAM_OAUTH_TOKEN_URL=https://api.instagram.com/oauth/access_token
INSTAGRAM_LONG_LIVED_TOKEN_URL=https://graph.instagram.com/access_token
# Inert compatibility input; secure refresh uses the client-constrained provider endpoint.
INSTAGRAM_REFRESH_TOKEN_URL=https://graph.instagram.com/refresh_access_token
# Used by analytics readiness only; it cannot change the active client's exact permission.
INSTAGRAM_OAUTH_SCOPES=instagram_business_basic
INSTAGRAM_TOKEN_REFRESH_WINDOW_DAYS=14
INSTAGRAM_PUBLISH_MODE=dry_run
INSTAGRAM_CONTAINER_POLL_ATTEMPTS=5
INSTAGRAM_CONTAINER_POLL_DELAY_MS=1000
WORKER_PUBLISHING_INTERVAL_MS=60000
WORKER_TOKEN_REFRESH_INTERVAL_MS=3600000
WORKER_USAGE_RESET_INTERVAL_MS=3600000
META_REDIRECT_URI=http://localhost:4000/v1/workspace/instagram/oauth/callback
META_WEBHOOK_VERIFY_TOKEN=change-me-for-meta-dashboard

# --- Email ---
EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=
SES_REGION=me-south-1
FROM_EMAIL=no-reply@markos.bh

# --- Observability ---
SENTRY_DSN=
